# demo: fictional data, no Firebase or external AI requests.
# firebase: requires all public web configuration values below.
VITE_APP_MODE=demo
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_REGION=asia-northeast3
VITE_APPCHECK_SITE_KEY=
VITE_USE_EMULATORS=false
# Never put an OpenAI key or admin credential in VITE_* variables.
