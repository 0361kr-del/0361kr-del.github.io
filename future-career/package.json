{
  "name": "future-career-interview",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-future-career 'GCLOUD_PROJECT=demo-future-career node --import tsx --test tests/firestore.rules.test.mts tests/student-api.integration.mts'",
    "emulators": "firebase emulators:start --project demo-future-career",
    "build:functions": "npm --prefix functions run build"
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "firebase-tools": "^14.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0"
  }
}
